{% extends "_base.html.j2" %}
{% from "_paper.html.j2" import paper_row %}

{% block extra_css %}
.hero{padding:36px 0 4px;}
.hero-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(0,1fr);gap:40px;align-items:start;}
.hero-main{display:flex;flex-direction:column;gap:18px;min-width:0;}
.id-row{display:flex;gap:24px;align-items:center;}
.id-row img{width:128px;height:128px;object-fit:cover;border-radius:12px;border:1px solid #d5dde8;flex-shrink:0;}
.hero-text{display:flex;flex-direction:column;gap:8px;min-width:0;}
.hero h1{font-size:38px;}
.contact{display:flex;flex-wrap:wrap;gap:4px 18px;font-size:15px;color:var(--muted);}
.contact b{color:var(--ink);}
.buttons{display:flex;gap:8px;flex-wrap:wrap;margin-top:4px;}
.buttons .btn{padding:8px 14px;font-size:13.5px;}
.hero .prose p{font-size:16px;line-height:1.65;margin-bottom:10px;}
.hero-side{display:flex;flex-direction:column;gap:14px;min-width:0;position:sticky;top:96px;}
.card{background:#f7f9fc;border:1px solid #e3e8ef;border-radius:10px;padding:16px 18px;}
.card-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px;}
.card-head h2{margin:0;font-size:16px;font-weight:800;}
.card-head span{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--soft);}
.hero .news-row{display:flex;gap:14px;padding:5px 0;font-size:14.5px;line-height:1.5;border-top:1px solid var(--line-2);}
.hero .card-head + .news-row{border-top:0;}
.hero .news-row .d{flex:0 0 68px;font-family:var(--mono);font-size:12.5px;font-weight:500;color:var(--accent);padding-top:2px;}
.chat{background:#fff;border:1.5px solid var(--accent);border-radius:12px;padding:16px 18px;box-shadow:0 6px 20px rgba(29,79,145,.10);display:flex;flex-direction:column;gap:10px;}
.chat-head{display:flex;gap:12px;align-items:center;}
.chat-head img{width:40px;height:40px;border-radius:50%;object-fit:cover;flex-shrink:0;}
.chat-head b{display:block;font-size:16px;font-weight:800;color:var(--ink);}
.chat-head span{display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--soft);}
.chat-head span::before{content:"";width:8px;height:8px;border-radius:50%;background:#22a05a;}
.chat-text{font-size:14px;line-height:1.5;color:var(--ink-2);}
.chips{display:flex;flex-wrap:wrap;gap:6px;}
.chip{font:inherit;font-size:13px;font-weight:600;padding:5px 10px;border-radius:999px;border:1px solid var(--btn-line);background:var(--tint);color:var(--ink-2);cursor:pointer;}
.chip:hover,.chip.on{border-color:var(--accent);color:var(--accent);background:#fff;}
.chat .msg-form{gap:8px;}
.chat .msg-form textarea{min-height:78px;font-size:14.5px;}
.chat .msg-form input{font-size:14px;padding:8px 10px;}
.chat .send-row{display:flex;gap:8px;}
.chat .send-row input{flex:1;min-width:0;}
.chat .send-row button{flex-shrink:0;}
.chat .fine{font-size:12px;color:var(--soft);}
.content{display:flex;flex-direction:column;gap:44px;padding:40px 0 32px;}
.content .sec-head h2{font-size:26px;}
.content .paper{padding:16px 4px;}
.prose p{margin:0 0 14px;font-size:17px;line-height:1.75;color:var(--ink-2);}
.prose p:last-child{margin-bottom:0;}
.edu{display:flex;flex-direction:column;gap:22px;}
.edu-row{display:flex;gap:24px;align-items:center;}
.edu-mark{width:64px;height:64px;flex-shrink:0;border-radius:10px;border:1px solid var(--line);background:var(--tint);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;color:var(--accent);}
.edu-text{flex:1;display:flex;flex-direction:column;gap:4px;font-size:17px;}
.edu-text i{color:var(--muted);}
.edu-dates{font-family:var(--mono);font-size:14px;color:var(--soft);white-space:nowrap;}
.two-col{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:48px;align-items:start;}
.panel{background:#f7f9fc;border:1px solid #e3e8ef;border-radius:10px;padding:20px 24px;display:flex;flex-direction:column;gap:10px;font-size:16px;line-height:1.55;}
.note{font-size:14px;color:var(--soft);}
.stats{display:flex;gap:12px;flex-wrap:wrap;}
.stat{display:flex;align-items:baseline;gap:8px;padding:10px 16px;border:1px solid var(--line);border-radius:10px;background:var(--tint);color:var(--ink-2);font-size:15px;}
.stat:hover{text-decoration:none;border-color:var(--accent);color:var(--accent);}
.stat b{font-family:var(--mono);font-size:22px;font-weight:700;color:var(--accent);}

.msg-form{display:flex;flex-direction:column;gap:10px;}
.msg-form input,.msg-form textarea{width:100%;font:inherit;font-size:15px;color:var(--ink);padding:10px 12px;border:1px solid var(--btn-line);border-radius:6px;background:#fff;}
.msg-form input:focus,.msg-form textarea:focus{outline:2px solid var(--accent);outline-offset:-1px;border-color:var(--accent);}
.msg-form textarea{min-height:120px;resize:vertical;}
.msg-form button{align-self:flex-start;cursor:pointer;font-family:inherit;}
.msg-form .hp{position:absolute;left:-9999px;}
.form-status{font-size:13px;color:var(--soft);min-height:1.4em;}
.form-status.ok{color:#1b7a3d;}
.form-status.err{color:#b42318;}

#oneko{width:32px;height:32px;position:fixed;pointer-events:none;background-image:url('assets/oneko.gif');image-rendering:pixelated;z-index:9999;left:0;top:0;}
.shuttle{position:fixed;width:22px;height:26px;pointer-events:none;z-index:9998;}
.shuttle svg{width:100%;height:100%;}
@keyframes toss{0%{transform:translateY(0) rotate(0)}45%{transform:translateY(-56px) rotate(200deg)}100%{transform:translateY(0) rotate(360deg)}}
.shuttle.toss{animation:toss .6s ease-out;}
.shuttle.fade{transition:opacity .3s;opacity:0;}

@media (max-width: 900px){
  .hero{padding-top:32px;}
  .hero-grid{grid-template-columns:1fr;gap:28px;}
  .hero-side{position:static;}
}
@media (max-width: 760px){
  .id-row{flex-direction:column;align-items:flex-start;gap:20px;}
  .id-row img{width:120px;height:120px;}
  .hero h1{font-size:32px;}
  .two-col{grid-template-columns:1fr;gap:40px;}
  .edu-row{flex-wrap:wrap;}
  .edu-dates{width:100%;padding-left:88px;}
}
{% endblock %}

{% block content %}
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-main">
      <div class="id-row">
        <img src="{{ profile.avatar }}" alt="Portrait of {{ profile.short_name }}">
        <div class="hero-text">
          <div class="eyebrow">{{ profile.eyebrow }}</div>
          <h1>{{ profile.name }}</h1>
          <div class="contact">
            <span><b>E-mail:</b> {{ profile.email }}</span>
            {% if profile.address %}<span><b>Address:</b> {{ profile.address }}</span>{% endif %}
          </div>
          <div class="buttons">
            <a class="btn primary" href="{{ profile.cv }}">CV</a>
            {% for l in profile.links %}<a class="btn" href="{{ l.url }}">{{ l.label }}</a>{% endfor %}
          </div>
        </div>
      </div>
      <div id="about" class="prose">{% for p in site.about %}<p>{{ p }}</p>{% endfor %}</div>
      {% if site.news %}
      <div id="news" class="card">
        <div class="card-head"><h2>News</h2><span>Latest</span></div>
        {% for n in site.news[:5] %}<div class="news-row"><span class="d">{{ n.date }}</span><span>{{ n.text }}</span></div>{% endfor %}
      </div>
      {% endif %}
    </div>

    <aside class="hero-side">
      {% if contact %}
      <div class="chat" id="say-hi">
        <div class="chat-head">
          <img src="{{ profile.avatar }}" alt="">
          <div><b>{{ contact.chat_title }}</b><span>{{ contact.chat_status }}</span></div>
        </div>
        <div class="chat-text">{{ contact.chat_text }}</div>
        <div class="chips">{% for c in contact.starters %}<button type="button" class="chip" data-starter="{{ c.text | e }}">{{ c.label }}</button>{% endfor %}</div>
        <form class="msg-form" action="{{ contact.form_action }}" method="POST">
          <textarea name="message" placeholder="{{ contact.chat_placeholder }}" required></textarea>
          <div class="send-row">
            <input name="email" type="email" placeholder="Email for a reply (optional)" autocomplete="email">
            <button class="btn primary" type="submit">Send ➜</button>
          </div>
          <input class="hp" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true">
          <input type="hidden" name="_subject" value="New message from your website (quick chat)">
          <input type="hidden" name="_captcha" value="false">
          <div class="form-status fine" role="status">{{ contact.chat_fine }}</div>
        </form>
      </div>
      {% endif %}
    </aside>
  </div>
</section>

<div class="wrap content">

  <section id="research" class="sec">
    <div class="sec-head">
      <div><span class="kicker">Publications</span><h2>Selected Research</h2></div>
      <a class="more" href="publications.html">All publications →</a>
    </div>
    <div class="stats">
      <a class="stat" href="publications.html"><b>{{ stats.total }}</b><span>papers</span></a>
      <a class="stat" href="publications.html"><b>{{ stats.first_author }}</b><span>first-author papers</span></a>
    </div>
    <div class="papers">{% for p in selected %}{{ paper_row(p) }}{% endfor %}</div>
    <div class="note">* equal contribution</div>
  </section>

  {% if site.education %}
  <section id="education" class="sec">
    <div class="sec-head"><div><span class="kicker">Background</span><h2>Education &amp; Experience</h2></div></div>
    <div class="edu">
      {% for e in site.education %}
      <div class="edu-row">
        <div class="edu-mark">{{ e.mark }}</div>
        <div class="edu-text"><span>{{ e.place }}</span><i>{{ e.detail }}</i></div>
        <span class="edu-dates">{{ e.dates }}</span>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <div class="two-col">
    <section id="honors" class="sec">
      <div class="sec-head"><div><span class="kicker">Recognition</span><h2>Selected Honors &amp; Awards</h2></div></div>
      <div class="panel">{% for h in site.honors %}<span>{{ h }}</span>{% endfor %}</div>
    </section>
    <section id="service" class="sec">
      <div class="sec-head"><div><span class="kicker">Community</span><h2>Service</h2></div></div>
      <div class="panel">{% for s in site.service %}<span>{{ s }}</span>{% endfor %}</div>
    </section>
  </div>



</div>
{% endblock %}

{% block scripts %}
<script>
// Message forms: post to the form service in the background and show the result inline.
(function(){
  document.querySelectorAll('.msg-form').forEach(function(form){
    var status = form.querySelector('.form-status');
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var btn = form.querySelector('button[type=submit]');
      btn.disabled = true; status.className = 'form-status'; status.textContent = 'Sending…';
      fetch(form.action, { method: 'POST', headers: { 'Accept': 'application/json' }, body: new FormData(form) })
        .then(function(r){ if (!r.ok) throw new Error(r.status); return r.json(); })
        .then(function(d){
          // FormSubmit answers 200 with success "false" (e.g. form not activated yet), so check the body too.
          if (String(d.success) !== 'true') throw new Error(d.message || 'not sent');
          form.reset(); status.className = 'form-status ok'; status.textContent = 'Got it, thank you! Your message is in my inbox.';
        })
        .catch(function(){ status.className = 'form-status err'; status.textContent = 'Sorry, that did not go through. Please email me instead.'; })
        .finally(function(){ btn.disabled = false; });
    });
  });
  // Conversation starters: one click fills the box so nobody has to face a blank page.
  document.querySelectorAll('.chip').forEach(function(chip){
    chip.addEventListener('click', function(){
      var box = chip.closest('.chat').querySelector('textarea');
      document.querySelectorAll('.chip.on').forEach(function(c){ c.classList.remove('on'); });
      chip.classList.add('on');
      box.value = chip.dataset.starter; box.focus();
      box.setSelectionRange(box.value.length, box.value.length);
    });
  });
})();
</script>
<script>
// Easter egg: click anywhere and the cat fetches a badminton shuttlecock.
// Cat animation adapted from oneko.js (MIT) by adryd325: https://github.com/adryd325/oneko.js
(function(){
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  if (window.matchMedia('(pointer: coarse)').matches) return; // skip on touch screens

  var nekoEl = document.createElement('div');
  nekoEl.id = 'oneko';
  document.body.appendChild(nekoEl);

  var nekoPosX = window.innerWidth - 40, nekoPosY = window.innerHeight - 40;
  var targetX = nekoPosX, targetY = nekoPosY, nekoSpeed = 10;
  var frameCount = 0, idleTime = 20, idleAnimation = null, idleAnimationFrame = 0;
  var activeShuttle = null;

  var spriteSets = {
    idle: [[-3, -3]], alert: [[-7, -3]],
    scratchSelf: [[-5, 0], [-6, 0], [-7, 0]],
    scratchWallN: [[0, 0], [0, -1]], scratchWallS: [[-7, -1], [-6, -2]],
    scratchWallE: [[-2, -2], [-2, -3]], scratchWallW: [[-4, 0], [-4, -1]],
    tired: [[-3, -2]], sleeping: [[-2, 0], [-2, -1]],
    N: [[-1, -2], [-1, -3]], NE: [[0, -2], [0, -3]], E: [[-3, 0], [-3, -1]], SE: [[-5, -1], [-5, -2]],
    S: [[-6, -3], [-7, -2]], SW: [[-5, -3], [-6, -1]], W: [[-4, -2], [-4, -3]], NW: [[-1, 0], [-1, -1]]
  };
  function setSprite(name, frame) {
    var s = spriteSets[name][frame % spriteSets[name].length];
    nekoEl.style.backgroundPosition = (s[0] * 32) + 'px ' + (s[1] * 32) + 'px';
  }
  function resetIdle(){ idleAnimation = null; idleAnimationFrame = 0; }
  function idle() {
    idleTime += 1;
    if (idleTime > 10 && Math.floor(Math.random() * 200) === 0 && idleAnimation == null) {
      var avail = ['sleeping', 'scratchSelf'];
      if (nekoPosX < 32) avail.push('scratchWallW');
      if (nekoPosY < 32) avail.push('scratchWallN');
      if (nekoPosX > window.innerWidth - 32) avail.push('scratchWallE');
      if (nekoPosY > window.innerHeight - 32) avail.push('scratchWallS');
      idleAnimation = avail[Math.floor(Math.random() * avail.length)];
    }
    switch (idleAnimation) {
      case 'sleeping':
        if (idleAnimationFrame < 8) { setSprite('tired', 0); break; }
        setSprite('sleeping', Math.floor(idleAnimationFrame / 4));
        if (idleAnimationFrame > 192) resetIdle();
        break;
      case 'scratchWallN': case 'scratchWallS': case 'scratchWallE': case 'scratchWallW': case 'scratchSelf':
        setSprite(idleAnimation, idleAnimationFrame);
        if (idleAnimationFrame > 9) resetIdle();
        break;
      default:
        setSprite('idle', 0);
        return;
    }
    idleAnimationFrame += 1;
  }
  function frame() {
    frameCount += 1;
    var diffX = nekoPosX - targetX, diffY = nekoPosY - targetY;
    var distance = Math.sqrt(diffX * diffX + diffY * diffY);
    if (distance < nekoSpeed || distance < 48) { if (activeShuttle) catchShuttle(); idle(); return; }
    idleAnimation = null; idleAnimationFrame = 0;
    if (idleTime > 1) { setSprite('alert', 0); idleTime = Math.min(idleTime, 7); idleTime -= 1; return; }
    var dir = '';
    dir += diffY / distance > 0.5 ? 'N' : '';
    dir += diffY / distance < -0.5 ? 'S' : '';
    dir += diffX / distance > 0.5 ? 'W' : '';
    dir += diffX / distance < -0.5 ? 'E' : '';
    setSprite(dir, frameCount);
    nekoPosX -= (diffX / distance) * nekoSpeed;
    nekoPosY -= (diffY / distance) * nekoSpeed;
    nekoPosX = Math.min(Math.max(16, nekoPosX), window.innerWidth - 16);
    nekoPosY = Math.min(Math.max(16, nekoPosY), window.innerHeight - 16);
    nekoEl.style.left = (nekoPosX - 16) + 'px';
    nekoEl.style.top = (nekoPosY - 16) + 'px';
  }
  nekoEl.style.left = (nekoPosX - 16) + 'px';
  nekoEl.style.top = (nekoPosY - 16) + 'px';
  var last;
  function loop(ts) { if (!last) last = ts; if (ts - last > 100) { last = ts; frame(); } window.requestAnimationFrame(loop); }
  window.requestAnimationFrame(loop);

  function catchShuttle() {
    var s = activeShuttle; activeShuttle = null;
    s.classList.add('fade'); setTimeout(function(){ s.remove(); }, 300);
  }
  var BIRDIE_SVG =
    '<svg viewBox="0 0 22 26" xmlns="http://www.w3.org/2000/svg">' +
    '<g fill="none" stroke="#8a97a8" stroke-width="1.1" stroke-linejoin="round">' +
    '<path d="M11 2 L4 15 L11 12 L18 15 Z" fill="#ffffff"/><path d="M11 2 L11 12"/><path d="M11 2 L7 13.5"/><path d="M11 2 L15 13.5"/></g>' +
    '<ellipse cx="11" cy="16.5" rx="4.2" ry="5" fill="#C9773F" stroke="#8A4E28" stroke-width="0.8"/></svg>';
  document.addEventListener('click', function(e){
    if (activeShuttle || e.target.closest('a, button')) return;
    var shuttle = document.createElement('div');
    shuttle.className = 'shuttle toss';
    shuttle.innerHTML = BIRDIE_SVG;
    shuttle.style.left = (e.clientX - 11) + 'px';
    shuttle.style.top = (e.clientY - 40) + 'px';
    document.body.appendChild(shuttle);
    activeShuttle = shuttle;
    targetX = e.clientX; targetY = e.clientY; idleTime = 0;
  });
})();
</script>
{% endblock %}
