{% extends "_base.html.j2" %}
{% from "_paper.html.j2" import paper_row %}
{% set page_title = "Publications" %}

{% block extra_css %}
.pub-head{padding:56px 0 8px;}
.pub-head .wrap{display:flex;flex-direction:column;gap:16px;}
.pub-title-row{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;}
.ext{display:flex;gap:20px;font-size:15px;font-weight:600;flex-wrap:wrap;}
.lede{margin:0;font-size:17px;line-height:1.7;color:var(--muted);max-width:820px;}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;}
.chip{font-family:inherit;font-size:14px;font-weight:700;padding:10px 16px;min-height:44px;border-radius:999px;cursor:pointer;background:#fff;color:var(--ink-2);border:1px solid var(--btn-line);}
.chip span{opacity:.7;font-weight:500;margin-left:4px;}
.chip:hover{border-color:var(--accent);color:var(--accent);}
.chip.on{background:var(--accent);border-color:var(--accent);color:#fff;}
.years{display:flex;flex-direction:column;gap:36px;padding:32px 0 32px;}
.year{display:flex;gap:40px;align-items:flex-start;}
.year-label{flex:0 0 120px;padding-top:22px;font-family:var(--mono);font-size:28px;font-weight:500;color:var(--accent);}
.year .papers{flex:1;border-top:1px solid var(--line);min-width:0;}
@media (max-width: 760px){
  .year{flex-direction:column;gap:4px;}
  .year-label{flex-basis:auto;padding-top:0;}
}
{% endblock %}

{% block content %}
<section class="pub-head">
  <div class="wrap">
    <div class="eyebrow">Research output</div>
    <div class="pub-title-row">
      <h1>Publications</h1>
      <div class="ext">{% for l in profile.links if l.label == 'Google Scholar' %}<a href="{{ l.url }}">Google Scholar ↗</a>{% endfor %}<a href="https://dblp.org/search?q=Zhenyu+Lei">DBLP ↗</a></div>
    </div>
    <p class="lede">Full list in reverse chronological order. <b>*</b> denotes equal contribution. For the most up-to-date list, please see Google Scholar.</p>
    <div class="filters" role="group" aria-label="Filter by topic">
      <button type="button" class="chip on" data-filter="all" aria-pressed="true">All<span>{{ total }}</span></button>
      {% for t in topics %}<button type="button" class="chip" data-filter="{{ t.id }}" aria-pressed="false">{{ t.label }}<span>{{ t.count }}</span></button>{% endfor %}
    </div>
  </div>
</section>

<div class="wrap years">
  {% for g in groups %}
  <section class="year">
    <div class="year-label">{{ g.year }}</div>
    <div class="papers">{% for p in g.papers %}{{ paper_row(p) }}{% endfor %}</div>
  </section>
  {% endfor %}
</div>
{% endblock %}

{% block scripts %}
<script>
(function(){
  var chips = document.querySelectorAll('.chip');
  chips.forEach(function(chip){
    chip.addEventListener('click', function(){
      var f = chip.getAttribute('data-filter');
      chips.forEach(function(c){ var on = c === chip; c.classList.toggle('on', on); c.setAttribute('aria-pressed', on); });
      document.querySelectorAll('.year').forEach(function(y){
        var shown = 0;
        y.querySelectorAll('.paper').forEach(function(p){
          var ok = f === 'all' || p.getAttribute('data-topic') === f;
          p.hidden = !ok; if (ok) shown++;
        });
        y.hidden = shown === 0;
      });
    });
  });
})();
</script>
{% endblock %}
