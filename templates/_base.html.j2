<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ profile.name }}{% if page_title %} — {{ page_title }}{% endif %}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#EDEDE6; --ink-soft:#B7BBB2;
    --hero:#141914; --hero-line:#2B332B;
    --paper:#F4F3EE; --paper-raised:#FFFFFF;
    --text:#20241F; --text-soft:#565C53; --line:#E0DFD6;
    --navy:#2C3E6B; --navy-bg:#E7EAF1;
    --sage:#3F6B4F; --sage-bg:#E4EEE5;
    --rust:#9A4B2E; --rust-bg:#F3E4DC;
    --plum:#6B3F63; --plum-bg:#EFE2ED;
    --slate:#42525A; --slate-bg:#E4E9EB;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;background-color:var(--paper);color:var(--text);font-family:'Inter',sans-serif;-webkit-font-smoothing:antialiased;
    background-image:url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="220" height="220" viewBox="0 0 220 220"><path d="M 71.2 33.2 Q 92.9 44.6 115.1 54.7" stroke="rgb(196,169,169)" stroke-width="14.5" stroke-linecap="round" fill="none" opacity="0.27"/><path d="M 47.2 18.9 Q 47.4 39.6 49.7 60.2" stroke="rgb(201,182,140)" stroke-width="9.7" stroke-linecap="round" fill="none" opacity="0.31"/><path d="M 49.1 138.0 Q 22.3 126.3 -2.5 110.9" stroke="rgb(176,196,178)" stroke-width="14.2" stroke-linecap="round" fill="none" opacity="0.19"/><path d="M 63.7 31.7 Q 52.1 44.3 52.3 61.4" stroke="rgb(176,196,178)" stroke-width="12.4" stroke-linecap="round" fill="none" opacity="0.2"/><path d="M 41.3 21.4 Q 18.9 9.3 -5.4 1.4" stroke="rgb(163,177,196)" stroke-width="11.6" stroke-linecap="round" fill="none" opacity="0.29"/><path d="M 69.1 128.8 Q 57.0 147.2 56.0 169.3" stroke="rgb(176,196,178)" stroke-width="10.8" stroke-linecap="round" fill="none" opacity="0.19"/><path d="M 108.9 75.6 Q 87.1 68.8 76.1 48.8" stroke="rgb(214,199,168)" stroke-width="13.5" stroke-linecap="round" fill="none" opacity="0.25"/><path d="M 33.4 107.6 Q 30.9 92.2 19.1 82.1" stroke="rgb(214,199,168)" stroke-width="13.9" stroke-linecap="round" fill="none" opacity="0.31"/><path d="M 74.8 77.0 Q 72.9 53.5 87.6 35.0" stroke="rgb(201,182,140)" stroke-width="11.8" stroke-linecap="round" fill="none" opacity="0.33"/><path d="M 146.1 13.3 Q 138.8 -12.7 115.7 -26.9" stroke="rgb(163,177,196)" stroke-width="11.3" stroke-linecap="round" fill="none" opacity="0.23"/><path d="M 147.1 5.0 Q 164.3 19.8 168.2 42.2" stroke="rgb(201,182,140)" stroke-width="10.7" stroke-linecap="round" fill="none" opacity="0.21"/><path d="M 162.4 87.5 Q 133.9 94.8 105.1 88.8" stroke="rgb(163,177,196)" stroke-width="14.3" stroke-linecap="round" fill="none" opacity="0.27"/><path d="M 180.2 190.1 Q 165.8 201.9 148.4 208.8" stroke="rgb(163,177,196)" stroke-width="9.9" stroke-linecap="round" fill="none" opacity="0.33"/><path d="M 38.8 51.0 Q 20.9 50.9 3.5 54.4" stroke="rgb(196,169,169)" stroke-width="9.9" stroke-linecap="round" fill="none" opacity="0.23"/><path d="M 117.6 134.2 Q 126.0 152.8 144.5 161.3" stroke="rgb(214,199,168)" stroke-width="13.4" stroke-linecap="round" fill="none" opacity="0.28"/><path d="M 100.5 191.6 Q 89.2 164.6 75.8 138.6" stroke="rgb(163,177,196)" stroke-width="9.6" stroke-linecap="round" fill="none" opacity="0.24"/><path d="M 139.5 13.7 Q 149.9 26.5 147.3 42.8" stroke="rgb(196,169,169)" stroke-width="9.6" stroke-linecap="round" fill="none" opacity="0.28"/><path d="M 124.7 118.1 Q 97.0 105.4 80.6 79.8" stroke="rgb(176,196,178)" stroke-width="9.9" stroke-linecap="round" fill="none" opacity="0.28"/><path d="M 55.5 76.4 Q 64.8 95.3 83.9 104.1" stroke="rgb(163,177,196)" stroke-width="10.9" stroke-linecap="round" fill="none" opacity="0.26"/><path d="M 31.7 164.9 Q 5.6 164.6 -19.5 171.9" stroke="rgb(214,199,168)" stroke-width="14.7" stroke-linecap="round" fill="none" opacity="0.18"/><path d="M 116.2 32.3 Q 138.5 36.6 160.9 39.9" stroke="rgb(201,182,140)" stroke-width="10.6" stroke-linecap="round" fill="none" opacity="0.29"/><path d="M 80.7 36.7 Q 56.0 25.9 29.1 26.0" stroke="rgb(196,169,169)" stroke-width="12.7" stroke-linecap="round" fill="none" opacity="0.28"/><path d="M 173.4 166.8 Q 176.6 183.8 175.7 201.0" stroke="rgb(176,196,178)" stroke-width="12.0" stroke-linecap="round" fill="none" opacity="0.21"/><path d="M 160.8 217.7 Q 135.6 228.4 108.3 227.0" stroke="rgb(214,199,168)" stroke-width="11.7" stroke-linecap="round" fill="none" opacity="0.33"/><path d="M 206.1 217.4 Q 191.0 243.1 167.5 261.4" stroke="rgb(176,196,178)" stroke-width="11.0" stroke-linecap="round" fill="none" opacity="0.26"/><path d="M 106.2 216.8 Q 129.8 225.2 153.7 217.3" stroke="rgb(196,169,169)" stroke-width="9.5" stroke-linecap="round" fill="none" opacity="0.31"/><path d="M 145.3 200.2 Q 144.9 173.6 145.4 147.1" stroke="rgb(176,196,178)" stroke-width="12.8" stroke-linecap="round" fill="none" opacity="0.25"/><path d="M 19.1 208.2 Q -6.9 209.3 -30.7 219.9" stroke="rgb(201,182,140)" stroke-width="10.0" stroke-linecap="round" fill="none" opacity="0.3"/><path d="M 27.9 33.3 Q 31.2 4.1 47.7 -20.2" stroke="rgb(214,199,168)" stroke-width="12.9" stroke-linecap="round" fill="none" opacity="0.34"/><path d="M 77.1 120.7 Q 92.3 131.5 109.2 123.6" stroke="rgb(201,182,140)" stroke-width="14.6" stroke-linecap="round" fill="none" opacity="0.26"/></svg>');
    background-size:220px 220px;
    background-attachment:fixed;
  }
  .wrap{max-width:760px;margin:0 auto;padding:0 24px;}
  code{font-family:'IBM Plex Mono',monospace;}
  a{color:inherit;}

  /* ---- top nav (every page) ---- */
  .topnav-band{background-color:var(--hero);color:var(--ink);}
  header{display:flex;justify-content:space-between;align-items:center;padding:20px 0;}
  .brand{font-family:'IBM Plex Mono',monospace;font-size:13px;color:var(--ink-soft);text-decoration:none;}
  nav a{color:var(--ink-soft);text-decoration:none;font-size:12px;margin-left:22px;letter-spacing:.06em;text-transform:uppercase;transition:color .15s;}
  nav a:hover, nav a.active{color:#FBFBF7;}

  /* ---- page hero band (dark), used on every page but content differs ---- */
  .hero-band{
    color:var(--ink);border-top:1px solid var(--hero-line);
    background-color:var(--hero);
    background-image:url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="220" height="220" viewBox="0 0 220 220"><path d="M 95.4 191.8 Q 106.8 217.0 108.6 244.6" stroke="rgb(50,63,84)" stroke-width="13.6" stroke-linecap="round" fill="none" opacity="0.45"/><path d="M 71.7 119.8 Q 95.3 134.4 122.5 140.2" stroke="rgb(75,64,45)" stroke-width="13.9" stroke-linecap="round" fill="none" opacity="0.48"/><path d="M 113.7 182.0 Q 137.9 197.8 151.9 223.1" stroke="rgb(60,70,60)" stroke-width="11.6" stroke-linecap="round" fill="none" opacity="0.35"/><path d="M 40.3 0.9 Q 53.3 24.3 65.4 48.2" stroke="rgb(63,86,66)" stroke-width="11.0" stroke-linecap="round" fill="none" opacity="0.46"/><path d="M 114.0 122.2 Q 134.2 139.6 155.8 155.0" stroke="rgb(90,74,40)" stroke-width="9.3" stroke-linecap="round" fill="none" opacity="0.39"/><path d="M 21.5 99.5 Q 27.5 83.7 44.2 81.6" stroke="rgb(50,63,84)" stroke-width="12.0" stroke-linecap="round" fill="none" opacity="0.47"/><path d="M 112.7 152.4 Q 91.8 148.4 71.1 143.6" stroke="rgb(90,74,40)" stroke-width="14.3" stroke-linecap="round" fill="none" opacity="0.49"/><path d="M 207.3 57.1 Q 231.2 55.5 250.3 41.1" stroke="rgb(90,74,40)" stroke-width="11.4" stroke-linecap="round" fill="none" opacity="0.43"/><path d="M 69.5 147.7 Q 78.2 167.0 79.2 188.2" stroke="rgb(63,86,66)" stroke-width="9.9" stroke-linecap="round" fill="none" opacity="0.53"/><path d="M 157.5 145.3 Q 175.9 141.2 181.7 123.4" stroke="rgb(90,74,40)" stroke-width="9.6" stroke-linecap="round" fill="none" opacity="0.5"/><path d="M 194.7 35.8 Q 194.7 60.8 202.8 84.5" stroke="rgb(60,70,60)" stroke-width="11.5" stroke-linecap="round" fill="none" opacity="0.43"/><path d="M 78.5 20.3 Q 68.7 37.6 57.6 54.1" stroke="rgb(63,86,66)" stroke-width="12.1" stroke-linecap="round" fill="none" opacity="0.43"/><path d="M 65.0 211.4 Q 76.1 198.9 92.6 195.9" stroke="rgb(63,86,66)" stroke-width="10.6" stroke-linecap="round" fill="none" opacity="0.37"/><path d="M 199.3 39.9 Q 216.7 19.3 221.5 -7.3" stroke="rgb(50,63,84)" stroke-width="12.2" stroke-linecap="round" fill="none" opacity="0.43"/><path d="M 113.3 108.8 Q 103.9 126.6 106.3 146.6" stroke="rgb(90,74,40)" stroke-width="9.4" stroke-linecap="round" fill="none" opacity="0.44"/><path d="M 206.4 139.6 Q 226.1 159.2 252.8 166.5" stroke="rgb(63,86,66)" stroke-width="9.7" stroke-linecap="round" fill="none" opacity="0.4"/><path d="M 2.5 218.7 Q 21.6 210.4 38.2 197.8" stroke="rgb(63,86,66)" stroke-width="10.4" stroke-linecap="round" fill="none" opacity="0.46"/><path d="M 24.1 35.5 Q 32.1 48.5 32.9 63.8" stroke="rgb(50,63,84)" stroke-width="10.2" stroke-linecap="round" fill="none" opacity="0.46"/><path d="M 98.1 147.9 Q 113.4 133.9 110.2 113.3" stroke="rgb(63,86,66)" stroke-width="13.4" stroke-linecap="round" fill="none" opacity="0.35"/><path d="M 121.2 41.7 Q 137.9 25.8 160.8 24.4" stroke="rgb(75,64,45)" stroke-width="12.3" stroke-linecap="round" fill="none" opacity="0.48"/><path d="M 195.5 213.5 Q 204.9 230.8 203.7 250.4" stroke="rgb(90,74,40)" stroke-width="13.2" stroke-linecap="round" fill="none" opacity="0.52"/><path d="M 139.9 89.0 Q 160.8 88.6 176.8 102.1" stroke="rgb(63,86,66)" stroke-width="14.3" stroke-linecap="round" fill="none" opacity="0.48"/><path d="M 94.8 12.2 Q 76.6 28.9 58.6 45.7" stroke="rgb(50,63,84)" stroke-width="13.2" stroke-linecap="round" fill="none" opacity="0.47"/><path d="M 10.0 40.8 Q 28.3 38.5 46.6 41.6" stroke="rgb(50,63,84)" stroke-width="12.3" stroke-linecap="round" fill="none" opacity="0.54"/><path d="M 53.8 212.4 Q 49.8 233.5 30.2 242.2" stroke="rgb(75,64,45)" stroke-width="10.7" stroke-linecap="round" fill="none" opacity="0.37"/><path d="M 144.3 54.6 Q 163.1 74.2 188.8 83.2" stroke="rgb(90,74,40)" stroke-width="9.3" stroke-linecap="round" fill="none" opacity="0.43"/></svg>');
    background-size:220px 220px;
  }
  .hero{padding:44px 0;}
  .eyebrow{font-family:'IBM Plex Mono',monospace;font-size:12px;color:#8FA890;letter-spacing:.08em;text-transform:uppercase;margin-bottom:14px;}
  h1{font-family:'Newsreader',serif;font-weight:500;font-size:38px;line-height:1.12;margin:0 0 14px;letter-spacing:-.01em;color:#FBFBF7;}
  .hero-sub{font-size:15.5px;line-height:1.65;color:var(--ink-soft);margin:0;max-width:56ch;}

  /* ---- generic section ---- */
  main{padding-bottom:40px;}
  section{padding:36px 0;}
  section + section{border-top:1px solid var(--line);}
  .section-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px;}
  h2{font-family:'Newsreader',serif;font-weight:500;font-size:22px;margin:0;color:var(--text);}
  .section-sub{font-size:13px;color:var(--text-soft);margin:0 0 22px;}

  footer{padding:30px 0 60px;font-size:12px;color:var(--text-soft);border-top:1px solid var(--line);text-align:center;}
  .fun-stats{font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:var(--text-soft);margin-bottom:10px;}
  .fun-stats .sep{margin:0 8px;opacity:.5;}
  .fun-stats b{color:var(--text);}

  {% block extra_css %}{% endblock %}
</style>
</head>
<body>

<div class="topnav-band">
  <div class="wrap">
    <header>
      <a class="brand" href="index.html">{{ profile.name | lower }}</a>
      <nav>
        <a href="index.html" class="{{ 'active' if active=='home' }}">home</a>
        <a href="research.html" class="{{ 'active' if active=='research' }}">research</a>
        <a href="education.html" class="{{ 'active' if active=='education' }}">education</a>
        <a href="about.html" class="{{ 'active' if active=='about' }}">about</a>
      </nav>
    </header>
  </div>
</div>

{% block hero %}{% endblock %}

<main class="wrap">
  {% block content %}{% endblock %}
</main>

<footer>
  {% if fun_stats %}
  <div class="fun-stats">
    <span>距离上次打羽毛球 <b id="badmintonDays">–</b> 天</span>
    {% if fun_stats.reject_count_this_week is not none %}
    <span class="sep">·</span>
    <span>本周论文被reject次数: <b>{{ fun_stats.reject_count_this_week }}</b></span>
    {% endif %}
  </div>
  {% endif %}
  <div>built from data — edit the files in <code>data/</code>, push, done</div>
</footer>

{% if fun_stats and fun_stats.last_badminton_date %}
<script>
  (function(){
    var last = new Date("{{ fun_stats.last_badminton_date }}T00:00:00");
    var days = Math.floor((Date.now() - last.getTime()) / 86400000);
    var el = document.getElementById('badmintonDays');
    if (el) el.textContent = days;
  })();
</script>
{% endif %}

</body>
</html>
