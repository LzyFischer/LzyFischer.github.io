<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ profile.name }}{% if page_title %} — {{ page_title }}{% endif %}</title>
<meta name="description" content="{{ profile.name }} — {{ profile.eyebrow }}">
<link rel="icon" href="{{ profile.avatar }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --accent:#1d4f91; --accent-dark:#0f2f5c;
    --ink:#162638; --ink-2:#24364d; --muted:#3d4f66; --soft:#5a6b80;
    --line:#dde3ea; --line-2:#e8ecf1; --tint:#f1f5fa; --badge:#e6edf6;
    --tag:#8a4b00; --btn-line:#c9d3e0;
    --sans:'Plus Jakarta Sans',system-ui,-apple-system,'Segoe UI',sans-serif;
    --mono:'IBM Plex Mono',ui-monospace,SFMono-Regular,Menlo,monospace;
  }
  *{box-sizing:border-box;}
  [hidden]{display:none !important;}
  html{scroll-behavior:smooth;scroll-padding-top:88px;}
  body{margin:0;background:#fff;color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;display:flex;flex-direction:column;min-height:100vh;}
  a{color:var(--accent);text-decoration:none;}
  a:hover{color:var(--accent-dark);text-decoration:underline;}
  img{max-width:100%;}
  .wrap{width:min(1160px, 100% - 48px);margin:0 auto;}

  /* ---- header / nav (identical on every page) ---- */
  .site-header{position:sticky;top:0;z-index:10;background:rgba(255,255,255,.96);backdrop-filter:saturate(1.4) blur(6px);border-bottom:1px solid #e3e8ef;}
  .site-header .wrap{height:72px;display:flex;align-items:center;justify-content:space-between;gap:16px;}
  .brand{display:flex;align-items:center;gap:12px;color:var(--ink);font-weight:800;font-size:18px;white-space:nowrap;}
  .brand:hover{text-decoration:none;color:var(--ink);}
  .brand-mark{width:36px;height:36px;border-radius:8px;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;}
  .nav{display:flex;align-items:center;gap:4px;font-size:15px;font-weight:500;overflow-x:auto;scrollbar-width:none;}
  .nav::-webkit-scrollbar{display:none;}
  .nav a{color:#2c3e55;padding:10px 14px;border-bottom:2px solid transparent;white-space:nowrap;}
  .nav a:hover{color:var(--accent);text-decoration:none;}
  .nav a.active{color:var(--accent);font-weight:700;border-bottom-color:var(--accent);}
  .nav a.cv{color:var(--accent);border:1px solid var(--accent);padding:8px 16px;border-radius:6px;font-weight:700;margin-left:10px;}
  .nav a.cv:hover{background:var(--accent);color:#fff;}

  /* ---- shared pieces ---- */
  main{flex:1;}
  .eyebrow{font-family:var(--mono);font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);}
  h1{margin:0;font-size:50px;line-height:1.08;font-weight:800;letter-spacing:-.02em;}
  .sec{display:flex;flex-direction:column;gap:16px;}
  .sec-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;padding-bottom:12px;border-bottom:1px solid var(--line);}
  .sec-head .kicker{display:block;font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--soft);margin-bottom:6px;}
  .sec-head h2{margin:0;font-size:30px;font-weight:800;letter-spacing:-.01em;}
  .sec-head .more{font-weight:700;font-size:15px;white-space:nowrap;}
  .btn{display:inline-block;font-weight:600;font-size:14px;padding:11px 18px;border-radius:6px;border:1px solid var(--btn-line);background:#fff;color:var(--ink);}
  .btn:hover{text-decoration:none;border-color:var(--accent);color:var(--accent);}
  .btn.primary{background:var(--accent);border-color:var(--accent);color:#fff;}
  .btn.primary:hover{background:var(--accent-dark);color:#fff;}

  /* ---- paper row (homepage + publications) ---- */
  .papers{display:flex;flex-direction:column;}
  .paper{display:flex;gap:28px;padding:22px 4px;border-bottom:1px solid var(--line-2);}
  .paper-meta{flex:0 0 172px;display:flex;flex-direction:column;align-items:flex-start;gap:6px;}
  .venue{white-space:nowrap;font-family:var(--mono);font-size:13px;font-weight:500;color:var(--ink);background:var(--badge);padding:5px 10px;border-radius:4px;}
  .tag{font-size:12px;font-weight:700;color:var(--tag);}
  .paper-body{flex:1;display:flex;flex-direction:column;gap:6px;min-width:0;}
  .paper-title{font-size:18px;font-weight:700;line-height:1.4;color:var(--ink);}
  .paper-authors{font-size:15px;line-height:1.55;color:var(--soft);}
  .paper-authors b{color:var(--ink);font-weight:700;}
  .paper-links{display:flex;gap:16px;font-size:14px;font-weight:700;margin-top:2px;}

  footer{background:var(--tint);border-top:1px solid #e3e8ef;padding:28px 0;margin-top:40px;}
  footer .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-family:var(--mono);font-size:13px;color:var(--soft);}

  @media (max-width: 760px){
    h1{font-size:36px;}
    .sec-head h2{font-size:24px;}
    .brand .brand-name{display:none;}
    .paper{flex-direction:column;gap:10px;}
    .paper-meta{flex-direction:row;align-items:center;flex-basis:auto;}
  }
  {% block extra_css %}{% endblock %}
</style>
</head>
<body>

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="index.html"><span class="brand-mark">{{ profile.initials }}</span><span class="brand-name">{{ profile.short_name }}</span></a>
    <nav class="nav" aria-label="Main">
      <a href="index.html" class="{{ 'active' if active == 'home' }}">Home</a>
      <a href="publications.html" class="{{ 'active' if active == 'publications' }}">Publications</a>
      <a href="index.html#news">News</a>
      <a href="index.html#education">Education</a>
      <a href="index.html#honors">Honors</a>
      <a href="index.html#misc">Misc</a>
      <a class="cv" href="{{ profile.cv }}">CV ↓</a>
    </nav>
  </div>
</header>

<main>
{% block content %}{% endblock %}
</main>

<footer>
  <div class="wrap">
    <span>© {{ year_now }} {{ profile.short_name }}</span>
    <span>Last update: {{ updated }}</span>
  </div>
</footer>

{% block scripts %}{% endblock %}
</body>
</html>
